{# Cartouche d'un événement. ev = élément de la collection, lang = "fr" | "en" #}
{% macro eventCard(ev, lang, t, site) %}
{% set d = ev.data %}
{% set title = d["title_" ~ lang] %}
<article class="event">
  {% if d.image %}
  <img class="event__img" src="{{ d.image }}" alt="X-IA #{{ d.number }} — {{ title }}" width="1100" height="367">
  {% else %}
  <div class="event__img event__img--empty" role="img" aria-label="{{ t.events.no_image }}"><span>#{{ d.number }}</span></div>
  {% endif %}
  <div class="event__body">
    <p class="event__meta"><span class="event__no">#{{ d.number }}</span><span>{{ d.event_date | eventDate(lang) }}</span></p>
    {% if d.time or d.venue %}
    <p class="event__place">{{ d.time }}{% if d.time and d.venue %} · {% endif %}{{ d.venue }}</p>
    {% endif %}
    <h3 class="event__title">{{ title }}</h3>
    <p class="event__desc">{{ d["description_" ~ lang] }}</p>
    {% if d.speakers and d.speakers.length %}
    <div class="event__speakers">
      <p class="label">{{ t.events.speakers }}</p>
      <ul class="chips">
        {% for s in d.speakers %}
        <li class="chip"><b>{{ s.name }}</b>{% if s.detail %}<span>{{ s.detail }}</span>{% endif %}</li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}
    <p class="event__foot">
      {% if d.youtube %}
      <a class="btn btn--primary" href="{{ d.youtube }}" target="_blank" rel="noopener">{{ play() }} {{ t.events.watch }}</a>
      {% else %}
      <a class="btn btn--outline" href="{{ site.youtube_playlist }}" target="_blank" rel="noopener">{{ play() }} {{ t.events.playlist }}</a>
      {% endif %}
    </p>
  </div>
</article>
{% endmacro %}
